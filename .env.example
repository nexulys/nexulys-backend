# ══════════════════════════════════════════════════════════════
#  Novexa by Nexulys — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs.
#  Les variables REQUISES doivent être définies pour démarrer.
# ══════════════════════════════════════════════════════════════

# ── Server ──
PORT=5000
NODE_ENV=development                 # 'production' en prod (active CORS strict + cookies Secure)

# ── MongoDB (REQUIS) ──
MONGODB_URI=mongodb://localhost:27017/novexa

# ── JWT (REQUIS — le serveur refuse de démarrer sans) ──
JWT_SECRET=your_super_secret_jwt_key_here   # chaîne longue et aléatoire (32+ caractères)

# ── CORS (REQUIS en production) ──
# Origines autorisées, séparées par des virgules. Sans ça, le frontend est bloqué en prod.
ALLOWED_ORIGINS=https://novexa.nexulyspro2002.workers.dev

# ── App ──
APP_NAME=Novexa
APP_VERSION=1.0.0
APP_URL=http://localhost:5000        # URL publique (utilisée dans les liens email)
LOG_LEVEL=info                       # niveau des logs Winston (error|warn|info|http|debug)

# ── Intelligence artificielle (optionnel — sinon mode démo) ──
# Au moins une des deux. Groq est gratuit ; OpenAI payant.
GROQ_API_KEY=                        # https://console.groq.com (recommandé, gratuit)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Email — Option 1 : Resend (API HTTP) ──
RESEND_API_KEY=                      # si défini, prioritaire sur SMTP
RESEND_FROM=noreply@votre-domaine.fr

# ── Email — Option 2 : SMTP classique (Gmail, Brevo…) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_app     # mot de passe d'application (pas le mot de passe du compte)

# ── Stripe (optionnel — paiements) ──
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Espace admin Novexa ──
ADMIN_EMAIL=admin@novexa.fr          # destinataire des notifications RGPD / admin
ADMIN_SECRET=                        # mot de passe de connexion au back-office admin

# ── Seed (optionnel — jeu de données de démo) ──
SEED_SECRET=                         # si défini, active la route POST /api/seed protégée par ce secret

# ── Tâches planifiées (relances de paiement automatiques) ──
# Si défini, active POST /api/cron/relances (protégé par ce secret via header x-cron-secret).
# À appeler quotidiennement depuis un Render Cron Job.
CRON_SECRET=

# ── Monitoring (optionnel) ──
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Tests ──
TEST_MONGODB_URI=mongodb://localhost:27017/novexa_test
